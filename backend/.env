# PawPati Backend Environment Variables
NODE_ENV=development
PORT=8080
API_VERSION=v1

# PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pawpati_dev
DB_USER=pawpati_admin
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google Cloud Platform — Vertex AI (Gemini)
# Cloud Run: ADC otomatik çalışır, credential dosyası gerekmez.
# Lokal geliştirme: aşağıdaki satırı aktif edin:
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
GCP_PROJECT_ID=pawpati-prod
GCP_LOCATION=europe-west1
VERTEX_AI_MODEL_RECO=gemini-1.5-flash
VERTEX_AI_MODEL_OCR=gemini-1.5-pro

# iyzico Payment
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Firebase
FIREBASE_PROJECT_ID=pawpati-prod
FIREBASE_CLIENT_EMAIL=your_firebase_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# SendGrid
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@pawpati.com

# Netgsm SMS
NETGSM_USERNAME=your_netgsm_user
NETGSM_PASSWORD=your_netgsm_pass
NETGSM_HEADER=PAWPATI

# Application
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
